# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Server only (never NEXT_PUBLIC_). All optional: without them, money reminders stay in-app. ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/reminders.
CRON_SECRET=
# The Supabase secret key (Project Settings > API). Only the reminders cron uses it.
SUPABASE_SECRET_KEY=
# Production email: a Resend API key and the From address.
RESEND_API_KEY=
EMAIL_FROM="Folium <reminders@your-domain>"
# Local email: Mailpit from `supabase start` (same inbox as auth emails).
MAILPIT_URL=http://127.0.0.1:54324
