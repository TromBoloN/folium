# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# typescript
*.tsbuildinfo

# testing (Vitest coverage, Playwright output)
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# env files: only the example is committed
.env*
!.env.example

# supabase CLI local state (includes local service keys)
/supabase/.temp/
/supabase/.branches/

# vercel
.vercel

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# misc
*.pem

# local Claude Code settings
.claude/settings.local.json
CLAUDE.local.md

/playwright/.auth/

# design-review captures (scripts/visual-check.mjs)
/screenshots/
/docs/development
